# 이 파일을 terraform.tfvars로 복사해 값을 채웁니다.
# terraform.tfvars는 .gitignore에 잡혀 있어 커밋되지 않습니다.

# 사이트가 서비스될 도메인.
domain_name = "pixelzoom.app"

# 위 도메인이 속한 Route 53 호스팅 영역. **이미 존재해야 합니다.**
# apex 도메인을 쓰면 domain_name과 같은 값입니다.
# 확인: aws route53 list-hosted-zones --query 'HostedZones[].Name'
hosted_zone_name = "pixelzoom.app"

# 아래는 전부 기본값이 있습니다. 바꿀 이유가 있을 때만 적으세요.

# region             = "ap-northeast-2"
# github_repository  = "PixelZoom-Team/pixelzoom-web"

# www.pixelzoom.app을 잡아 apex로 301을 돌려줍니다. 끄면 www는 DNS 실패가 됩니다.
# include_www = true

# 계정에 GitHub OIDC 공급자가 이미 있다면 false로 둡니다.
# 확인: aws iam list-open-id-connect-providers
# create_oidc_provider = true

# 월 예산 알림을 받을 주소. 비워 두면 예산을 만들지 않습니다.
# IAM 사용자별로는 나눌 수 없습니다 — 비용은 계정에 귀속됩니다.
# budget_alert_emails = ["your@email"]
# monthly_budget_usd  = 5
# budget_scope        = "account"   # "project"로 좁히면 Route 53 영역이 빠집니다

# log_retention_days = 14
# lambda_memory_mb   = 2048
